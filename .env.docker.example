# Copy to .env for the Docker stacks:  cp .env.docker.example .env
# docker compose reads .env automatically.

# --- Production (docker-compose.prod.yml) ---
# Public hostname for automatic HTTPS (use "localhost" for local testing).
DOMAIN=localhost
# REQUIRED in prod: a strong random key clients must send as  X-API-Key: <key>
TRADEWATCH_API_KEY=change-me-to-a-long-random-string
TRADEWATCH_RATE_LIMIT_PER_MIN=1200
# Comma-separated CORS allowlist for your front-end origins ("" disables CORS).
TRADEWATCH_CORS_ORIGINS=

# --- Optional: Snowflake gold-layer load (batch runner) ---
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=tradewatch
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=TRADEWATCH_WH
# SNOWFLAKE_DATABASE=TRADEWATCH
# SNOWFLAKE_SCHEMA=GOLD
